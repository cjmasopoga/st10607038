<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude the nested Azure Functions project's files from this project's compilation. -->
    <Compile Remove="SmartMonitoringSolutions.Functions\**" />
    <Content Remove="SmartMonitoringSolutions.Functions\**" />
    <None Remove="SmartMonitoringSolutions.Functions\**" />
    <EmbeddedResource Remove="SmartMonitoringSolutions.Functions\**" />

    <!-- Exclude infra/deployment tooling folders from compilation and publish output. -->
    <Compile Remove="infra\**;scripts\**;.azure\**" />
    <Content Remove="infra\**;scripts\**;.azure\**" />
    <None Remove="infra\**;scripts\**;.azure\**" />
    <EmbeddedResource Remove="infra\**;scripts\**;.azure\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Data.Tables" Version="12.13.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
  </ItemGroup>

</Project>
