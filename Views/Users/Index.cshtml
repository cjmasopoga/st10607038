@model List<SmartMonitoringSolutions.Models.User>
@{
    ViewData["Title"] = "Users";
}

<h1>User Accounts</h1>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<a asp-action="Create" class="btn btn-primary mb-3">Create User</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Username</th>
            <th>Role</th>
            <th>Created (UTC)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Username</td>
                <td><span class="badge bg-info text-dark">@user.Role</span></td>
                <td>@user.CreatedAtUtc.ToString("u")</td>
                <td>
                    <form asp-action="Delete" asp-route-id="@user.Id" method="post" onsubmit="return confirm('Delete this user?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
